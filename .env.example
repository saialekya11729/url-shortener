DATABASE_URL=postgresql+psycopg://urlshortener:urlshortener@localhost:5432/url_shortener
DB_POOL_SIZE=50
DB_MAX_OVERFLOW=100

# Non-Docker Windows alternative using local SQL Server trusted auth:
# DATABASE_URL=mssql+pyodbc://@localhost/url_shortener?driver=ODBC+Driver+17+for+SQL+Server&trusted_connection=yes&TrustServerCertificate=yes
